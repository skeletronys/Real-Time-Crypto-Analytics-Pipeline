#  AWS CONFIGURATION
AWS_ACCESS_KEY_ID=# AWS access key ID for programmatic access (keep this secret in real .env)
AWS_SECRET_ACCESS_KEY=# AWS secret access key — never share publicly (use environment variables or Secrets Manager in production)
AWS_REGION=# AWS region where your services (S3, Athena, etc.) are hosted, e.g., "us-east-1"
AWS_S3_BUCKET_RAW=# S3 bucket for storing raw data (e.g., directly from data producers or Kafka)
AWS_S3_BUCKET_TRANSFORMED=# S3 bucket for transformed/processed data (e.g., after cleaning or enrichment)
AWS_ATHENA_OUTPUT_LOCATION=# S3 location where Athena query results will be stored, e.g., "s3://your-bucket/athena-results/"
# Kafka CONFIGURATION
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PRICES=crypto-prices
KAFKA_TOPIC_TRADES=crypto-trades
KAFKA_CONSUMER_GROUP=crypto-consumers
# COINGECKO API CONFIGURATION
COINGECKO_API_KEY=# Your CoinGecko API key (get it from https://www.coingecko.com/en/api)
FETCH_INTERVAL_SECONDS=# Interval (in seconds) between API calls — e.g., 30 means request data every 30 seconds
CRYPTO_SYMBOLS=# List of cryptocurrency symbols to track, separated by commas (e.g., bitcoin,ethereum,binancecoin)

ENVIRONMENT=development
LOG_LEVEL=INFO